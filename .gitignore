# ============================================================
# .gitignore — Attendance Management System
# ============================================================

# ─── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ────────────────────────────────────────────
dist/
build/
out/
.output/
*.tsbuildinfo
.expo/
.expo-shared/

# ─── Environment & Secrets — NEVER COMMIT ───────────────────
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
.env*.local
*.secret
*.pem
*.key
*.p12
*.pfx
secrets/

# ─── Database Backups — NEVER COMMIT ────────────────────────
data/backups/
data/uploads/
data/

# ─── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
/tmp/

# ─── OS Files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── IDE / Editor ─────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ─── Testing & Coverage ───────────────────────────────────────
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/

# ─── Replit Internal ──────────────────────────────────────────
.cache/
.local/
.replit
replit.nix

# ─── Misc ─────────────────────────────────────────────────────
*.tgz
*.tar.gz
.npm/
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
.nx/cache/
tmp/
connect.lock
/typings
